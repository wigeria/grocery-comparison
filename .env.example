# Copy to .env and fill in. .env is gitignored.

# Claude subscription token for the server. Create it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Host user and group ids that own data/ and db/. Find them with: id -u / id -g
APP_UID=1000
APP_GID=1000

# Hostname Caddy serves: your DuckDNS name (e.g. mygroceries.duckdns.org),
# or localhost for local testing.
SITE_ADDRESS=localhost

# Certificate method: internal (local testing) or duckdns (real certificate).
CADDY_TLS=internal

# Only for CADDY_TLS=duckdns. Shown on duckdns.org after signing in.
DUCKDNS_TOKEN=
